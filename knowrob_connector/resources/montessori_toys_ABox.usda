def Mujoco "mujoco" (
    prepend apiSchemas = ["MujocoOptionAPI"]
)
{
    string mujoco:model = "montessori_toys"
    float mujoco:option:timestep = 0.002

    def MujocoAsset "asset"
    {
        def MujocoMesh "meshes"
        {
            def MujocoMesh "montessori_box_MontessoriBox"
            {
                asset mujoco:mesh:file = @./montessori_toys/meshes/stl/montessori_box_MontessoriBox.stl@
            }

            def MujocoMesh "montessori_box_MontessoriDrawer"
            {
                asset mujoco:mesh:file = @./montessori_toys/meshes/stl/montessori_box_MontessoriDrawer.stl@
            }

            def MujocoMesh "montessori_box_MontessoriDrawerHandle"
            {
                asset mujoco:mesh:file = @./montessori_toys/meshes/stl/montessori_box_MontessoriDrawerHandle.stl@
            }

            def MujocoMesh "montessori_object_2_MontessoriObject_002"
            {
                asset mujoco:mesh:file = @./montessori_toys/meshes/stl/montessori_object_2_MontessoriObject_002.stl@
            }
        }

        def MujocoMaterial "materials"
        {
        }

        def MujocoTexture "textures"
        {
        }
    }

    def MujocoEquality "equality"
    {
    }
}

